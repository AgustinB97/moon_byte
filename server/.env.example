PORT=5000

# ── Sentry (monitoreo de errores) ──
# Obtener DSN en https://sentry.io → New Project → Node.js
# Si está vacío, Sentry queda deshabilitado
SENTRY_DSN=
MONGODB_URI=mongodb://localhost:27017/moonbyte
JWT_SECRET=cambiame-en-produccion-usa-algo-aleatorio-de-64-chars-minimo
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ── SMTP / Email (Gmail con App Password) ──
# Para obtener SMTP_PASS:
#   1. Activar 2FA en https://myaccount.google.com/security
#   2. Generar App Password en https://myaccount.google.com/apppasswords
#   3. Pegar acá el código de 16 caracteres SIN espacios
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=moonbyte.hardware@gmail.com
SMTP_PASS=tu-app-password-de-16-caracteres-aca
SMTP_FROM=MoonByte <moonbyte.hardware@gmail.com>

# Email que recibe las solicitudes de aprobación cuando admin crea/edita/elimina un producto
APPROVAL_EMAIL=

# ── Mercado Pago ──
# Para conseguir un token de prueba:
#   1. https://www.mercadopago.com.ar/developers/panel
#   2. Crear/abrir una Aplicación
#   3. En "Credenciales de prueba" copiar el Access Token (empieza con TEST-)
# Si lo dejás vacío, el checkout corre en modo MOCK (no requiere pago real).
MP_ACCESS_TOKEN=
# Si exponés webhooks públicamente (producción):
# MP_WEBHOOK_URL=https://tu-dominio.com/api/orders/webhook
# MP_WEBHOOK_SECRET=  # Lo configurás en el panel de MP → Webhooks → Configurar firma

# ── Envíos (Envia.com + Andreani) ──
# Token estático desde shipping-test.envia.com/settings/developers (sandbox)
# o shipping.envia.com/settings/developers (producción)
# Si está vacío, todos los endpoints corren en modo MOCK
ENVIA_TOKEN=
ENVIA_BASE_URL=https://api-test.envia.com
ENVIA_CARRIER=andreani
# Datos del origen (dirección del negocio desde donde se despacha)
ENVIA_ORIGEN_NOMBRE=MoonByte
ENVIA_ORIGEN_TELEFONO=1100000000
ENVIA_ORIGEN_CALLE=Calle Falsa
ENVIA_ORIGEN_CIUDAD=Buenos Aires
ENVIA_ORIGEN_PROVINCIA=Buenos Aires
ENVIA_ORIGEN_CP=1000
# Código del servicio Andreani a usar al generar etiquetas (viene de la cotización)
ENVIA_SERVICE=standard

# ── Datos bancarios para pagos por transferencia ──
BANK_HOLDER=Tu Nombre o Razón Social
BANK_CBU=0000000000000000000000
BANK_ALIAS=TU.ALIAS.ACA
BANK_NAME=Banco

# ── Cloudinary (storage de imágenes) ──
# Para obtener:
#   1. https://cloudinary.com/users/register/free
#   2. Dashboard → Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
